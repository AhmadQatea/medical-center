APP_NAME="CarePoint"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Medical center identity (org-level)
MEDICAL_CENTER_NAME="المركز الطبي التخصصي"
APP_BRAND_NAME=CarePoint

# Default seeded department (first clinic in database)
DEFAULT_CLINIC_NAME="عيادة الأسنان"
DEFAULT_CLINIC_SLUG=dental

# Public booking WhatsApp (override per doctor in clinic settings)
MEDICAL_CENTER_WHATSAPP=0959422413

# Seeded admin login (local/testing)
DOCTOR_EMAIL=clinic@example.com
# Required outside local/testing:
# DOCTOR_PASSWORD=admin123123

# Production: set APP_DEBUG=false, APP_ENV=production,
# SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true (HTTPS)

APP_TIMEZONE=Asia/Damascus
CLINIC_TIMEZONE=Asia/Damascus

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production (HTTPS): SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Laravel Cloud: prefer redis when available
# CACHE_STORE=redis
# CACHE_PREFIX=

# Production deploy: php artisan optimize (config/route/view cache)
# Keep APP_DEBUG=false, SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
